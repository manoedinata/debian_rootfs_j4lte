# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# PMIC
CONFIG_EXYNOS_SPEEDY=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_S2MPU06=y
CONFIG_MFD_S2MPU06=y
CONFIG_INPUT_S2MPU06_PWRKEY=y
CONFIG_RTC_DRV_S2MPU06=y
CONFIG_CHARGER_S2MPU06=y
CONFIG_POWER_SUPPLY=y
CONFIG_EXYNOS_ADC=y
CONFIG_IIO=y
CONFIG_NVMEM=y
CONFIG_CRC8=y
CONFIG_EXTCON=y
CONFIG_EXTCON_SM5502=y
CONFIG_I2C_S3C2410=y
CONFIG_I2C=y
