# The FIMC-IS camera nodes are internal plumbing, not cameras: hide them from
# /dev/video* by moving them to /dev/camd/ under stable names (the j4cam module
# and camd open them there). Format enumerators and v4l_id then never see them.
SUBSYSTEM=="video4linux", ATTR{name}=="exynos-fimc-is-*", RUN+="/bin/sh -c 'mkdir -p /dev/camd && mv -f /dev/%k /dev/camd/%s{name}'"
