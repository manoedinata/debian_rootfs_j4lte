#!/bin/busybox sh

export PATH=/bin

# /dev/kmsg goes into the kernel ring buffer, so it survives into the next
# boot's last_kmsg; /dev/console only reaches a live display/serial, which
# we usually don't have attached. Log to both.
log() {
	echo "init: $1" >/dev/kmsg 2>/dev/null
	echo "init: $1" >/dev/console 2>/dev/null
}

# j4.autoreboot=<seconds> on the kernel command line (mainline test images):
# reboot instead of idling in the rescue shell, so a test boot ends by itself
# and the log can be read from the next (Debian) boot's ramoops.
mount -t proc proc /proc
autoreboot=""
wtest=""
bootreboot=""
for arg in $(cat /proc/cmdline 2>/dev/null); do
	case "$arg" in
		j4.autoreboot=*) autoreboot="${arg#j4.autoreboot=}" ;;
		j4.wtest=*)      wtest="${arg#j4.wtest=}" ;;
		j4.bootreboot=*) bootreboot="${arg#j4.bootreboot=}" ;;
	esac
done

# j4.wtest=<offset_MiB>:<size_MiB>: eMMC write-path test, only ever on USERDATA
# (mmcblk0p25, a fresh unused ext4). Writes random data, fsyncs, drops the
# caches, reads it back and compares hashes; the hash is logged so a later boot
# with another kernel can verify the same region.
write_test() {
	dev=/dev/mmcblk0p25
	off=${wtest%%:*}
	size=${wtest##*:}
	if [ -z "$off" ] || [ -z "$size" ] || [ "$off" -lt 1024 ] || [ "$size" -lt 1 ] || [ "$size" -gt 64 ]; then
		log "wtest: refusing offset=$off size=$size (need offset>=1024 MiB, 1<=size<=64 MiB)"
		return
	fi
	dev_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null)
	if [ -z "$dev_bytes" ] || [ $(( (off + size) * 1048576 )) -gt "$dev_bytes" ]; then
		log "wtest: $dev too small or missing ($dev_bytes bytes)"
		return
	fi
	log "wtest: $dev offset ${off} MiB size ${size} MiB"
	dd if=/dev/urandom of=/wtest.pat bs=1M count="$size" 2>/dev/null
	want=$(sha256sum /wtest.pat | cut -d' ' -f1)
	t0=$(date +%s)
	dd if=/wtest.pat of="$dev" bs=1M seek="$off" conv=fsync 2>/dev/null
	sync
	t1=$(date +%s)
	echo 3 >/proc/sys/vm/drop_caches
	blockdev --flushbufs "$dev"
	got=$(dd if="$dev" bs=1M skip="$off" count="$size" 2>/dev/null | sha256sum | cut -d' ' -f1)
	t2=$(date +%s)
	log "wtest: want $want"
	log "wtest: got  $got"
	if [ "$want" = "$got" ]; then
		log "wtest: RESULT OK (write $((t1 - t0))s, read $((t2 - t1))s)"
	else
		log "wtest: RESULT MISMATCH"
	fi
	rm -f /wtest.pat
}

rescue_shell() {
	log "$1"
	if [ -n "$autoreboot" ]; then
		log "autoreboot in ${autoreboot}s"
		sleep "$autoreboot"
		sync
		log "rebooting now"
		reboot -f
		log "reboot -f returned, falling back to the rescue shell"
	fi
	log "Dropping to rescue shell."
	# A one-shot "exec sh" dies the instant stdin has no interactive
	# source (no serial/USB console attached yet) - sh hits EOF, exits
	# 0, and PID 1 exiting at all panics the kernel. Loop instead, so a
	# dead console just idles here rather than panicking.
	while true; do
		/bin/busybox sh
		sleep 5
	done
}

mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev || rescue_shell "Failed to mount devtmpfs."
log "devtmpfs mounted"

# Mainline bring-up safety net: make the next reset of any kind (even a held
# power button during a hang) boot BOOT instead of RECOVERY. INFORM3 (PMU_ALIVE
# + 0x80c) holds the boot reason; 0x12345670 = normal. /dev/mem only exists on
# the mainline kernel, so this is a no-op on the downstream one.
[ -c /dev/mem ] && devmem 0x11c8080c 32 0x12345670 2>/dev/null && log "INFORM3 set to normal boot"

# Mainline kernel: the same RNDIS network device (rndis0, same MAC addresses as
# the downstream gadget so the host keeps its interface name and DHCP setup)
# through the upstream configfs gadget framework.
setup_usb_configfs() {
	if ! mount -t configfs configfs /sys/kernel/config 2>/dev/null; then
		log "no android_usb gadget and no configfs, skipping USB network setup"
		return
	fi
	i=0
	while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ "$i" -lt 20 ]; do
		sleep 0.5
		i=$((i + 1))
	done
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	if [ -z "$udc" ]; then
		log "no UDC registered, skipping USB network setup"
		return
	fi
	g=/sys/kernel/config/usb_gadget/j4
	mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" "$g/functions/rndis.usb0" || return
	echo 0x18d1 >"$g/idVendor"
	echo 0xd001 >"$g/idProduct"
	echo "j4lte" >"$g/strings/0x409/serialnumber"
	echo "Samsung" >"$g/strings/0x409/manufacturer"
	echo "Galaxy J4 (mainline)" >"$g/strings/0x409/product"
	echo "RNDIS" >"$g/configs/c.1/strings/0x409/configuration"
	# upstream names the device side "usb0"; the installed system (unudhcpd.service)
	# is bound to rndis0, the name the downstream android_usb gadget used
	# (the kernel insists on exactly one %d and rejects a plain "rndis0")
	echo 'rndis%d' >"$g/functions/rndis.usb0/ifname" 2>/dev/null || log "USB gadget: setting ifname FAILED"
	echo 7a:50:b5:6f:88:a3 >"$g/functions/rndis.usb0/dev_addr"
	echo 52:d8:64:70:20:45 >"$g/functions/rndis.usb0/host_addr"
	ln -s "$g/functions/rndis.usb0" "$g/configs/c.1/rndis.usb0"
	if echo "$udc" >"$g/UDC" 2>/dev/null; then
		log "USB gadget (rndis0) bound to UDC $udc"
	else
		log "USB gadget: binding to UDC $udc FAILED"
	fi
}

setup_usb_network() {
	# This kernel builds the Samsung/AOSP downstream "android_usb"
	# composite gadget driver (g_android, CONFIG_USB_G_ANDROID) instead
	# of the upstream USB_CONFIGFS gadget framework postmarketOS uses -
	# this kernel has USB_CONFIGFS disabled entirely. g_android registers
	# this sysfs node unconditionally at boot (it's a late_initcall, not
	# tied to a DT platform device), so if it's missing, this kernel
	# build doesn't have USB_G_ANDROID either.
	sysfs_dir=/sys/class/android_usb/android0
	if [ ! -e "$sysfs_dir" ]; then
		setup_usb_configfs
		return
	fi

	log "setting up USB network gadget (rndis) via android_usb"
	echo 0     >"$sysfs_dir/enable"
	echo 18D1  >"$sysfs_dir/idVendor"    # Google Inc.
	echo D001  >"$sysfs_dir/idProduct"   # Nexus 4 (fastboot) - generic placeholder
	echo rndis >"$sysfs_dir/functions"
	echo 1     >"$sysfs_dir/enable"
	# That's as far as the initramfs goes: just getting the rndis0 netdev
	# to exist. Giving it an IP and running unudhcpd is unudhcpd.service's
	# job on the real root, not ours - the initramfs doesn't even carry
	# the unudhcpd binary anymore.
}
setup_usb_network

# Root is SYSTEM (mmcblk0p18), flashed from misc-files/system.img (see
# build_system_img.sh). USERDATA is left alone for Android's /data.
# An explicit root= on the kernel cmdline overrides this.
root=/dev/mmcblk0p18
fallback_root=""
rootfstype=ext4
rootflags=rw
init=/sbin/init

for arg in $(cat /proc/cmdline); do
	case "$arg" in
		root=*)       root="${arg#root=}"; fallback_root="" ;;
		rootfstype=*) rootfstype="${arg#rootfstype=}" ;;
		rootflags=*)  rootflags="${arg#rootflags=}" ;;
		init=*)       init="${arg#init=}" ;;
	esac
done

[ -z "$root" ] && rescue_shell "No root= given on kernel cmdline."

# root= can name a device node directly, or a by-id/by-partlabel/by-uuid/by-label alias.
case "$root" in
	PARTLABEL=*) root="/dev/disk/by-partlabel/${root#PARTLABEL=}" ;;
	PARTUUID=*)  root="/dev/disk/by-partuuid/${root#PARTUUID=}" ;;
	UUID=*)      root="/dev/disk/by-uuid/${root#UUID=}" ;;
	LABEL=*)     root="/dev/disk/by-label/${root#LABEL=}" ;;
esac

# eMMC partitions can take a moment to enumerate after devtmpfs mounts.
i=0
while [ ! -e "$root" ] && [ "$i" -lt 15 ]; do
	sleep 1
	i=$((i + 1))
done

if [ -e "$root" ]; then
	log "found root device: $root"
else
	# No ueventd here, so there's no /dev/block/by-name - only raw
	# mmcblkNpM nodes from devtmpfs. Dump both that and the kernel's own
	# partition table so the real device/partition names show up in the
	# next last_kmsg.
	log "/dev/block: $(find /dev/block -maxdepth 3 2>&1)"
	log "/proc/partitions: $(cat /proc/partitions 2>&1)"
	# INFORM3 was set to "normal boot" above, so a reset lands in BOOT (the
	# downstream system) instead of looping here: a mainline kernel that lost
	# its eMMC must not strand the phone.
	log "rebooting in 20s"
	sleep 20
	reboot -f
	rescue_shell "Timed out waiting for root device: $root"
fi

# Test boots (j4.autoreboot): mount read-only, report and reboot instead of
# handing over to the installed system.
[ -n "$autoreboot" ] && rootflags=ro

mkdir -p /mnt/root
if mount -t "$rootfstype" -o "$rootflags" "$root" /mnt/root; then
	log "mounted $root ($rootfstype) on /mnt/root"
elif [ -n "$fallback_root" ] && [ -e "$fallback_root" ] &&
		mount -t "$rootfstype" -o "$rootflags" "$fallback_root" /mnt/root; then
	log "failed to mount $root, mounted fallback $fallback_root ($rootfstype) on /mnt/root"
	root="$fallback_root"
else
	rescue_shell "Failed to mount $root as $rootfstype on /mnt/root."
fi

if [ -n "$autoreboot" ]; then
	log "test boot: root $root mounted ($rootflags), not switching root"
	log "root dir: $(ls /mnt/root 2>&1 | tr '\n' ' ')"
	log "os-release: $(head -n 2 /mnt/root/etc/os-release 2>&1 | tr '\n' ' ')"
	log "/proc/partitions: $(cat /proc/partitions 2>&1)"
	umount /mnt/root
	[ -n "$wtest" ] && write_test
	rescue_shell "test boot done"
fi

for d in proc sys dev run; do
	[ -d "/mnt/root/$d" ] || mkdir -p "/mnt/root/$d"
done

# Mount the stock VENDOR partition (camera/MFC firmware, see
# firmware_class.path=/vendor/firmware) read-only before userspace starts.
# Left to fstab, vendor.mount only comes up once udev has announced the
# device (~22 s), by which time udev's v4l_id probing has already opened the
# FIMC-IS/MFC nodes and their request_firmware() calls failed with -2.
# Best effort: systemd adopts an already-mounted /vendor from fstab as-is.
vendor_dev=/dev/mmcblk0p19
if [ -e "$vendor_dev" ] && [ -d /mnt/root/vendor ]; then
	if mount -t ext4 -o ro "$vendor_dev" /mnt/root/vendor; then
		log "mounted $vendor_dev (ro) on /mnt/root/vendor"
	else
		log "failed to mount $vendor_dev on /mnt/root/vendor, continuing"
	fi
fi

# busybox switch_root prints its generic usage/help text (not a distinct
# error) for *any* failed precondition, including "not PID 1" or "NEW_ROOT
# not a mountpoint" - not just a wrong arg count. Log both directly so we
# can tell which one it actually is instead of guessing from the help text.
# j4.bootreboot=<seconds>: bring-up boots of the installed system on a kernel
# that cannot be interacted with yet. A timer started inside the new root (the
# chroot sees the same filesystem as PID 1 after switch_root) syncs, remounts
# everything read-only and reboots through SysRq, whatever state systemd is in.
# INFORM3 was already set to "normal boot" above, so the reboot lands in BOOT.
if [ -n "$bootreboot" ]; then
	log "bootreboot: sysrq sync/ro/reboot in ${bootreboot}s"
	script=$(cat <<'EOS'
sleep "$1"
echo s >/proc/sysrq-trigger; sleep 3; echo u >/proc/sysrq-trigger; sleep 2; echo b >/proc/sysrq-trigger
EOS
)
	( chroot /mnt/root /bin/sh -c "$script" j4 "$bootreboot" >/dev/null 2>&1 & )
fi

log "switch_root /mnt/root $init"

exec switch_root /mnt/root "$init"
# switch_root only returns on failure - on success it execs $init and never
# comes back here.
rescue_shell "switch_root failed (root=$root init=$init)"
