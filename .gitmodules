[submodule "kernel"]
	path = kernel
	url = https://github.com/DaunScape/android_kernel_samsung_universal7570
[submodule "samsungipcd"]
	path = samsungipcd
	url = https://github.com/manoedinata/samsungipcd.git
[submodule "libsamsung-ipc"]
	path = libsamsung-ipc
	url = https://github.com/manoedinata/libsamsung-ipc.git
	branch = shannon-lte-data
[submodule "fbkeyboard"]
	path = fbkeyboard
	url = https://github.com/manoedinata/fbkeyboard.git
[submodule "uniLoader"]
	path = uniLoader
	url = https://github.com/manoedinata/uniLoader
[submodule "linux-7.2.y"]
	path = linux-7.2.y
	url = https://github.com/manoedinata/linux.git
	branch = exynos7570-mainline
[submodule "linux-6.12.y"]
	path = linux-6.12.y
	url = https://github.com/manoedinata/linux.git
	branch = exynos7570-6.12
[submodule "openwrt"]
	path = openwrt
	url = https://github.com/manoedinata/openwrt.git
	branch = j4lte-25.12
[submodule "openwrt-feed"]
	path = openwrt-feed
	url = https://github.com/manoedinata/openwrt-feed-j4lte.git
	branch = main
